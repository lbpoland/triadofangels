{
  "type": "module",
  "scripts": {
    "toa:sync-layout": "node tools/toa-layout-sync.mjs --sync --write",
    "toa:qa": "node tools/toa-qa.mjs",
    "toa:normalize-head": "node tools/toa-head-normalize.mjs --write",
    "toa:refresh": "node tools/toa-refresh.mjs",
    "toa:refresh:with-head-normalize": "node tools/toa-refresh.mjs --normalize-head",
    "toa:lhci:desktop": "lhci autorun --config=.lighthouserc.desktop.json",
    "toa:lhci:mobile": "lhci autorun --config=.lighthouserc.mobile.json",
    "toa:lighthouse": "npm run toa:lhci:desktop && npm run toa:lhci:mobile",
    "toa:release": "node tools/toa-release-pack.mjs",
    "toa:release:zip": "node tools/toa-release-pack.mjs --zip",
    "toa:release:check": "node tools/toa-release-check.mjs --dir dist",
    "toa:lighthouse:desktop": "npm run toa:lhci:desktop",
    "toa:lighthouse:mobile": "npm run toa:lhci:mobile",
    "toa:js-syntax": "node tools/toa-js-syntax-audit.mjs",
    "toa:shell:audit": "node tools/toa-shell-audit.mjs",
    "toa:content:export": "node tools/toa-content-build.mjs --write",
    "toa:content:validate": "node tools/toa-content-validate.mjs",
    "toa:shell:ledger": "node tools/toa-shell-ledger.mjs",
    "toa:content:build": "node tools/toa-content-build.mjs --write",
    "toa:sync-layout:check": "node tools/toa-layout-sync.mjs --sync --check --report",
    "toa:shell:verify": "node tools/toa-shell-audit.mjs && node tools/toa-shell-ledger.mjs && node tools/toa-layout-sync.mjs --sync --check --report",
    "toa:content:build:check": "node tools/toa-content-build.mjs",
    "toa:content:contracts": "node tools/toa-content-validate.mjs",
    "toa:shell:governance": "node tools/toa-shell-audit.mjs && node tools/toa-shell-ledger.mjs && node tools/toa-layout-sync.mjs --sync --check --report",
    "toa:bundle:compat": "node tools/toa-bundle-compatibility-audit.mjs --write",
    "toa:bundle:compat:prep": "node tools/toa-bundle-compatibility-audit.mjs --write"
  }
}
